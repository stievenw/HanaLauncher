<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hana Launcher - Burn bootstrapper. Produces the single-file setup EXE that
  wraps the MSI (HanaLauncher.wxs) and shows the standard install wizard.

  Build: see build-setup.ps1. The bundle uses its own UpgradeCode, so running
  a newer setup EXE over an older install upgrades in place.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension">

  <Bundle Name="Hana Launcher"
          Version="1.0.10"
          Manufacturer="StievenW"
          UpgradeCode="AB403C0C-D365-4812-B5DE-0060465FB5AC"
          IconSourceFile="..\assets\icon.ico">

    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication LicenseFile="license.rtf" />
    </BootstrapperApplicationRef>

    <Chain>
      <MsiPackage Id="HanaLauncherMsi"
                  SourceFile="HanaLauncher.msi" />
    </Chain>
  </Bundle>
</Wix>