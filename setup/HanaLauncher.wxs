<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hana Launcher - MSI product definition (WiX 3.14).

  Build: see build-setup.ps1. candle+light from tools-wix are used so the
  setup can be built without any extra software.

  Install wizard: the standard WiX install dialog flow (WixUI_InstallDir).
  The INSTALLFOLDER defaults to %APPDATA%\.minecraft (the global Minecraft
  folder) and can be changed in the wizard. Launcher data (versions,
  libraries, assets, runtime, saves, ...) lives next to the executable, so it
  follows the chosen install location.

  Upgrade flow: a fixed ProductCode + fixed UpgradeCode means installing a
  newer setup over an older one replaces the program in place. Launcher data
  (versions, libraries, assets, game saves, logs) lives in the install folder,
  so it survives updates as long as the folder is kept.

  Uninstall flow: the MSI removes the program files and, via a deferred custom
  action, wipes the user data folder (%APPDATA%\Hana\HanaLauncher - accounts,
  settings and cache) so a reinstall starts completely clean. The cleanup only
  runs on a full uninstall (REMOVE=ALL AND NOT UPGRADINGPRODUCTCODE) so an
  upgrade never touches the user's data. An Uninstall.exe shipped in the
  install folder also performs the full cleanup (standard Windows uninstall
  wizard, wipe AppData + registry, msiexec /x, delete the install folder).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="B4A9D1C8-6E3F-4A2B-9C7E-5F0D8A1B2C3D"
           Name="Hana Launcher"
           Language="1033"
           Version="1.0.7"
           Manufacturer="StievenW"
           UpgradeCode="3638E624-4ABC-49DB-9DD7-A1CC3B71E5EB">

    <Package Id="*"
             InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Manufacturer="StievenW"
             Description="Hana Launcher - Minecraft Launcher"
             Comments="Hana Launcher setup - StievenW" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Hana Launcher is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <!-- Standard install wizard (Welcome -> License -> Install folder ->
         Ready). The INSTALLFOLDER defaults to %APPDATA%\.minecraft (the global
         Minecraft folder) and can be changed in the wizard; launcher data
         (versions, libraries, assets, runtime, saves, ...) lives next to the
         executable, so it follows the chosen install location. -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <UIRef Id="WixUI_InstallDir" />

    <!-- User data folder (%APPDATA%\Hana\HanaLauncher) is wiped on a FULL
         uninstall so a reinstall starts completely clean. The cleanup runs
         deferred (as SYSTEM) and is guarded so an UPGRADE never touches the
         user's data. -->
    <CustomAction Id="SetRemoveDataCmd"
                  Property="REMOVE_USER_DATA_CMD"
                  Value="cmd /c rd /s /q &quot;[AppDataFolder]Hana\HanaLauncher&quot;" />
    <CustomAction Id="RunRemoveData"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SetRemoveDataCmd"
              Before="RunRemoveData">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RunRemoveData"
              After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="Hana Launcher" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="AppDataFolder">
        <Directory Id="INSTALLFOLDER" Name=".minecraft" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>
  </Product>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Per-user install folders: components must use an HKCU registry value
           as their KeyPath (ICE38) and the folders must be in the RemoveFile /
           RemoveFolder tables (ICE64). RemoveFolder only removes empty folders,
           so launcher data (versions/, libraries/, ...) survives uninstall. -->
      <Component Id="ProductExe" Guid="91965BBD-C9D5-4E73-A9B8-22F7F7DE7F50" Win64="yes">
        <File Id="HanaLauncherExe"
              Source="..\target\release\HanaLauncher.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="exe"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- One-click full uninstaller shipped in the install root: shows the
           standard Windows Installer uninstall wizard, wipes
           %APPDATA%\Hana\HanaLauncher + registry, and deletes the install
           folder. -->
      <Component Id="UninstallScript" Guid="3C9E7B21-5A4D-4F08-B6C2-8E1D0A9F4C55" Win64="yes">
        <File Id="UninstallExe"
              Name="Uninstall.exe"
              Source="..\target\release\uninstall.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="uninstall_script"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- External resource files (icon, background artwork, Monogram fonts).
           Kept out of the exe so the launcher binary stays small. -->
      <Directory Id="RESOURCESDIR" Name="resources">
        <Component Id="ResourceIcon" Guid="FC95E013-8461-44E4-B4C9-FC8786B97855" Win64="yes">
          <File Id="ResourceIconPng"
                Source="..\resources\icon.png.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_icon"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceBg" Guid="E24BB7D0-C381-4730-AD6F-34FA810E4D1A" Win64="yes">
          <File Id="ResourceBgJpg"
                Source="..\resources\bg.jpg.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_bg"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceFont" Guid="36A0096E-8CDE-4DA3-8F42-DA2390D9B0AE" Win64="yes">
          <File Id="ResourceFontTtf"
                Source="..\resources\monogram.ttf.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_font"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceFontItalic" Guid="3E897FF6-484B-478A-8CF6-886D51FD0DD0" Win64="yes">
          <File Id="ResourceFontItalicTtf"
                Source="..\resources\monogram-italic.ttf.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_font_italic"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>

      <Component Id="RemoveInstallDirs" Guid="8657F0AC-1DC5-448F-A4E7-3A99C3EFAF66" Win64="yes">
        <!-- RemoveFolder only removes empty folders; non-empty launcher data
             (versions/, libraries/, ...) in the install root survives the MSI
             uninstall and is cleaned by Uninstall.exe instead. -->
        <RemoveFolder Id="RemoveResourcesFolder"
                      Directory="RESOURCESDIR"
                      On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder"
                      Directory="INSTALLFOLDER"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="install_dirs"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuHanaLauncher"
                  Name="Hana Launcher"
                  Target="[INSTALLFOLDER]HanaLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder"
                      Directory="ProgramMenuFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="start_menu_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopHanaLauncher"
                  Name="Hana Launcher"
                  Target="[INSTALLFOLDER]HanaLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="desktop_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="ProductExe" />
      <ComponentRef Id="UninstallScript" />
      <ComponentRef Id="ResourceIcon" />
      <ComponentRef Id="ResourceBg" />
      <ComponentRef Id="ResourceFont" />
      <ComponentRef Id="ResourceFontItalic" />
      <ComponentRef Id="RemoveInstallDirs" />
    </ComponentGroup>
  </Fragment>
</Wix>
