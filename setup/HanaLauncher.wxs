<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hana Launcher - MSI product definition (WiX 3.14).

  Build: see build-setup.ps1. candle+light from tools-wix are used so the
  setup can be built without any extra software.

  Upgrade flow: a fixed ProductCode + fixed UpgradeCode means installing a
  newer setup over an older one replaces the program in place. Launcher data
  (versions, libraries, assets, game saves, logs) lives next to the executable
  in the install folder, so it survives updates as long as the folder is kept.

  Uninstall flow: the MSI removes the program files and, via a deferred custom
  action, wipes the user data folder (%APPDATA%\Hana\HanaLauncher - accounts,
  settings and cache) so a reinstall starts completely clean. The cleanup only
  runs on a full uninstall (REMOVE=ALL AND NOT UPGRADINGPRODUCTCODE) so an
  upgrade never touches the user's data. An Uninstall.exe shipped in the
  install folder also performs the full cleanup (standard Windows uninstall
  wizard, wipe AppData + registry, msiexec /x, delete the install folder).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="B4A9D1C8-6E3F-4A2B-9C7E-5F0D8A1B2C3D"
           Name="Hana Launcher"
           Language="1033"
           Version="1.0.5"
           Manufacturer="StievenW"
           UpgradeCode="3638E624-4ABC-49DB-9DD7-A1CC3B71E5EB">

    <Package Id="*"
             InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Manufacturer="StievenW"
             Description="Hana Launcher - Minecraft Launcher"
             Comments="Hana Launcher setup - StievenW" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Hana Launcher is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="app.ico" SourceFile="..\assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- Public property (uppercase) passed from the UI to the elevated server;
         marked Secure so it is never stripped. Value is set by InitLauncherDir
         before the dialogs show. -->
    <Property Id="LAUNCHER_DIRECTORY" Secure="yes" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <WixVariable Id="WixUIBannerBitmap" Value="WixUI_Bmp_Banner" />
    <UIRef Id="WixUI_InstallDir" />

    <!-- Launcher Directory selection page inserted between InstallDirDlg and
         VerifyReadyDlg. The publish below (same Order as the built-in
         NewDialog to VerifyReadyDlg) is authored after the UI extension's rows,
         so it fires first and the built-in navigation is skipped. -->
    <UI>
      <Dialog Id="LauncherDirDlg" Width="370" Height="270" Title="Launcher Directory">
        <Control Id="BannerBitmap"
                 Type="Bitmap"
                 X="0" Y="0" Width="370" Height="44"
                 TabSkip="no"
                 Text="!(wix.WixUIBannerBitmap)" />
        <Control Id="Title"
                 Type="Text"
                 X="15" Y="6" Width="340" Height="15"
                 TabSkip="no"
                 Text="Launcher Directory" />
        <Control Id="Description"
                 Type="Text"
                 X="25" Y="23" Width="280" Height="15"
                 TabSkip="no"
                 Text="Choose the folder where launcher data is stored (versions, accounts, settings). Default is the .minecraft folder." />
        <Control Id="BannerLine"
                 Type="Line"
                 X="0" Y="44" Width="370" Height="0"
                 TabSkip="no" />
        <Control Id="FolderLabel"
                 Type="Text"
                 X="20" Y="60" Width="150" Height="15"
                 TabSkip="no"
                 Text="Launcher Directory:" />
        <Control Id="FolderEdit"
                 Type="Edit"
                 X="20" Y="80" Width="320" Height="18"
                 Property="LAUNCHER_DIRECTORY"
                 Indirect="no" />
        <Control Id="Browse"
                 Type="PushButton"
                 X="304" Y="103" Width="56" Height="17"
                 Text="Browse...">
          <Publish Event="SpawnDialog" Value="LauncherDirBrowseDlg" Order="1">1</Publish>
        </Control>
        <Control Id="Back"
                 Type="PushButton"
                 X="180" Y="243" Width="56" Height="17"
                 Text="&lt; Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="1">1</Publish>
        </Control>
        <Control Id="Next"
                 Type="PushButton"
                 X="236" Y="243" Width="56" Height="17"
                 Default="yes"
                 Text="Next &gt;">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="1">1</Publish>
        </Control>
        <Control Id="Cancel"
                 Type="PushButton"
                 X="304" Y="243" Width="56" Height="17"
                 Cancel="yes"
                 Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" Order="1">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="LauncherDirBrowseDlg"
              Width="370"
              Height="270"
              Title="Browse for Folder"
              TrackDiskSpace="yes">
        <Control Id="BannerBitmap"
                 Type="Bitmap"
                 X="0" Y="0" Width="370" Height="44"
                 TabSkip="no"
                 Text="!(wix.WixUIBannerBitmap)" />
        <Control Id="Title"
                 Type="Text"
                 X="15" Y="6" Width="340" Height="15"
                 TabSkip="no"
                 Text="Launcher Directory" />
        <Control Id="Description"
                 Type="Text"
                 X="25" Y="23" Width="280" Height="15"
                 TabSkip="no"
                 Text="Choose the Launcher Directory folder." />
        <Control Id="BannerLine"
                 Type="Line"
                 X="0" Y="44" Width="370" Height="0"
                 TabSkip="no" />
        <Control Id="FolderLabel"
                 Type="Text"
                 X="20" Y="60" Width="150" Height="15"
                 TabSkip="no"
                 Text="Launcher Directory:" />
        <Control Id="PathEdit"
                 Type="PathEdit"
                 X="20" Y="80" Width="320" Height="18"
                 Property="LAUNCHER_DIRECTORY"
                 Indirect="no" />
        <Control Id="OK"
                 Type="PushButton"
                 X="304" Y="243" Width="56" Height="17"
                 Default="yes"
                 Text="OK">
          <Publish Event="EndDialog" Value="Return" Order="1">1</Publish>
        </Control>
        <Control Id="Cancel"
                 Type="PushButton"
                 X="240" Y="243" Width="56" Height="17"
                 Cancel="yes"
                 Text="Cancel">
          <Publish Event="EndDialog" Value="Return" Order="1">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="InstallDirDlg"
               Control="Next"
               Event="NewDialog"
               Value="LauncherDirDlg"
               Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
    </UI>

    <!-- User data folder (%APPDATA%\Hana\HanaLauncher) is wiped on a FULL
         uninstall so a reinstall starts completely clean. The cleanup runs
         deferred (as SYSTEM) and is guarded so an UPGRADE never touches the
         user's data. -->
    <CustomAction Id="SetRemoveDataCmd"
                  Property="REMOVE_USER_DATA_CMD"
                  Value="cmd /c rd /s /q &quot;[AppDataFolder]Hana\HanaLauncher&quot;" />
    <CustomAction Id="RunRemoveData"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Launcher Directory wizard page: prefilled with the default .minecraft
         path so the standard folder-select page already points at it. The
         chosen folder is written to HKCU\Software\Hana\HanaLauncher and the
         launcher reads it on first run. Type 51 runs after CostFinalize so
         [AppDataFolder] is resolved. -->
    <CustomAction Id="InitLauncherDir"
                  Property="LAUNCHER_DIRECTORY"
                  Value="[AppDataFolder].minecraft" />

    <InstallUISequence>
      <!-- Sequence 1005 sits between CostFinalize (1000, resolves AppDataFolder)
           and WelcomeDlg (1298). Referencing WelcomeDlg by name here pulls in the
           WixUI_Advanced fragment, so a numeric sequence is used instead. -->
      <Custom Action="InitLauncherDir" Sequence="1005" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="SetRemoveDataCmd"
              Before="RunRemoveData">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RunRemoveData"
              After="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <Feature Id="ProductFeature" Title="Hana Launcher" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="INSTALLFOLDER" Name="HanaLauncher" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>
  </Product>

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Per-user install folders: components must use an HKCU registry value
           as their KeyPath (ICE38) and the folders must be in the RemoveFile /
           RemoveFolder tables (ICE64). RemoveFolder only removes empty folders,
           so launcher data (versions/, libraries/, ...) survives uninstall. -->
      <Component Id="ProductExe" Guid="91965BBD-C9D5-4E73-A9B8-22F7F7DE7F50" Win64="yes">
        <File Id="HanaLauncherExe"
              Source="..\target\release\HanaLauncher.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="exe"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- One-click full uninstaller shipped in the install root: shows the
           standard Windows Installer uninstall wizard, wipes
           %APPDATA%\Hana\HanaLauncher + registry, and deletes the install
           folder. -->
      <Component Id="UninstallScript" Guid="3C9E7B21-5A4D-4F08-B6C2-8E1D0A9F4C55" Win64="yes">
        <File Id="UninstallExe"
              Name="Uninstall.exe"
              Source="..\target\release\uninstall.exe" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="uninstall_script"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- External resource files (icon, background artwork, Monogram fonts).
           Kept out of the exe so the launcher binary stays small. -->
      <Directory Id="RESOURCESDIR" Name="resources">
        <Component Id="ResourceIcon" Guid="FC95E013-8461-44E4-B4C9-FC8786B97855" Win64="yes">
          <File Id="ResourceIconPng"
                Source="..\resources\icon.png.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_icon"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceBg" Guid="E24BB7D0-C381-4730-AD6F-34FA810E4D1A" Win64="yes">
          <File Id="ResourceBgJpg"
                Source="..\resources\bg.jpg.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_bg"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceFont" Guid="36A0096E-8CDE-4DA3-8F42-DA2390D9B0AE" Win64="yes">
          <File Id="ResourceFontTtf"
                Source="..\resources\monogram.ttf.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_font"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Component Id="ResourceFontItalic" Guid="3E897FF6-484B-478A-8CF6-886D51FD0DD0" Win64="yes">
          <File Id="ResourceFontItalicTtf"
                Source="..\resources\monogram-italic.ttf.x" />
          <RegistryValue Root="HKCU"
                         Key="Software\Hana\HanaLauncher"
                         Name="res_font_italic"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>

      <Component Id="RemoveInstallDirs" Guid="8657F0AC-1DC5-448F-A4E7-3A99C3EFAF66" Win64="yes">
        <!-- RemoveFolder only removes empty folders; non-empty launcher data
             (versions/, libraries/, ...) in the install root survives the MSI
             uninstall and is cleaned by Uninstall.exe instead. -->
        <RemoveFolder Id="RemoveResourcesFolder"
                      Directory="RESOURCESDIR"
                      On="uninstall" />
        <RemoveFolder Id="RemoveInstallFolder"
                      Directory="INSTALLFOLDER"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="install_dirs"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- Launcher Directory chosen in the setup wizard is persisted here so
           the launcher can read it on first run (see Config::setup_launcher_dir).
           Empty value (or missing) means the default .minecraft folder. -->
      <Component Id="WriteLauncherDir" Guid="E9C6A1F4-8B2D-4E70-A1C5-3D9F6B0A2E81" Win64="yes">
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="launcher_directory"
                       Type="string"
                       Value="[LAUNCHER_DIRECTORY]"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuHanaLauncher"
                  Name="Hana Launcher"
                  Target="[INSTALLFOLDER]HanaLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico" />
        <RemoveFolder Id="RemoveStartMenuFolder"
                      Directory="ProgramMenuFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="start_menu_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopHanaLauncher"
                  Name="Hana Launcher"
                  Target="[INSTALLFOLDER]HanaLauncher.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="app.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\Hana\HanaLauncher"
                       Name="desktop_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="ProductComponents">
      <ComponentRef Id="ProductExe" />
      <ComponentRef Id="UninstallScript" />
      <ComponentRef Id="ResourceIcon" />
      <ComponentRef Id="ResourceBg" />
      <ComponentRef Id="ResourceFont" />
      <ComponentRef Id="ResourceFontItalic" />
      <ComponentRef Id="RemoveInstallDirs" />
      <ComponentRef Id="WriteLauncherDir" />
    </ComponentGroup>
  </Fragment>
</Wix>
